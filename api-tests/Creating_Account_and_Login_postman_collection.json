		{
			"name": "Registration with 250-character username (maximum allowed)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generate a username consisting of 250 'a' characters\r",
							"let longUsername = \"a\".repeat(250);\r",
							"\r",
							"// Generate a unique number to append to the email for uniqueness\r",
							"let randomNumber = Math.floor(Math.random() * 100000);\r",
							"\r",
							"// Set environment variables for use in the request body\r",
							"pm.environment.set(\"long_username\", longUsername);\r",
							"pm.environment.set(\"random_number\", randomNumber);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Check status code is 200\r",
							"pm.test(\"Status code is 200\", () => {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Parse response JSON\r",
							"let response = pm.response.json();\r",
							"\r",
							"// Check username length is 250\r",
							"pm.test(\"Username length is 250 characters\", () => {\r",
							"    pm.expect(response.username.length).to.eql(250);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"username\": \"{{long_username}}\",\r\n  \"email\": \"user250_{{random_number}}@test.com\",\r\n  \"password\": \"Password123\",\r\n  \"language\": \"en\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{Base_URL}}/api/v1/register",
					"host": [
						"{{Base_URL}}"
					],
					"path": [
						"api",
						"v1",
						"register"
					]
				}
			},
			"response": []
		},
